<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PrasaResearch.Desktop.App" RequestedThemeVariant="Dark">
 <Application.Styles>
  <FluentTheme/>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
  <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI, San Francisco, Arial"/><Setter Property="Foreground" Value="#EDF3FF"/></Style>
  <Style Selector="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9DB4D8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="#101D35"/><Setter Property="BorderBrush" Value="#29446A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#1B2B4A"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style Selector="Button:pointerover"><Setter Property="Opacity" Value="0.8"/></Style>
  <Style Selector="Button"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions></Setter></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#3448B9"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#249DFF"/><GradientStop Color="#6338EF" Offset="1"/></LinearGradientBrush></Setter><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="#0A1428"/><Setter Property="BorderBrush" Value="#3A557D"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinWidth" Value="160"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style Selector="DataGrid"><Setter Property="Background" Value="#091324"/><Setter Property="RowBackground" Value="#0B1425"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="38"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
 </Application.Styles>
</Application>
