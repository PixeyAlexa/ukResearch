<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PrasaResearch.Desktop.MainWindow" Title="PrasaResearch • Revenue Explorer" Width="1480" Height="960" MinWidth="1080" MinHeight="720" Background="#060E20" WindowDecorations="None" CanResize="True" WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="76,*,66">
  <Border Background="#0A1427" BorderBrush="#29446A" BorderThickness="0,0,0,1" Padding="22,12" PointerPressed="Title_PointerPressed">
   <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="14"><Image Source="/Assets/app.png" Width="42" Height="42"/><StackPanel><TextBlock Text="UK Companies House" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PrasaResearch · Revenue Explorer" Classes="muted"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="─" Click="Minimize_Click"/><Button Content="□" Click="Maximize_Click"/><Button Content="✕" Click="Close_Click"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="218,*">
   <Border Background="#0A1529" BorderBrush="#29446A" BorderThickness="1" CornerRadius="15" Margin="10,12,0,12" Padding="10">
    <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="12,20"><TextBlock Text="PRASA RESEARCH" FontWeight="SemiBold"/><TextBlock Text="Official UK Government Data" Classes="muted" FontSize="11" Margin="0,8,0,0"/></StackPanel><ListBox Background="Transparent" ItemsSource="{Binding Navigation}" SelectedItem="{Binding Section}"/></DockPanel>
   </Border>
   <ScrollViewer Grid.Column="1" Padding="24,18,24,10" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="UK Companies House" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Revenue Explorer" FontSize="27" Foreground="#9AB4FF"/><TextBlock Text="Latest annual revenue. Trace every figure to its source." Classes="muted" Margin="0,8,0,24"/>
     <Border Classes="panel" IsVisible="{Binding IsSingle}"><StackPanel Spacing="10"><TextBlock Text="Single Company Search" Classes="heading"/><TextBlock Text="Company registration number" Classes="muted"/><Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding Number}" PlaceholderText="Company number, including prefix and leading zeros"/><Button Grid.Column="1" Content="Get Revenue" Classes="primary" Command="{Binding SearchCommand}" Margin="14,0,8,0"/><Button Grid.Column="2" Content="View Company Profile" Command="{Binding ProfileCommand}" CommandParameter="Input"/></Grid></StackPanel></Border>
     <Border Classes="panel" IsVisible="{Binding IsBulk}" DragDrop.AllowDrop="True" DragDrop.Drop="Import_Drop" DragDrop.DragOver="Import_DragOver"><StackPanel Spacing="12"><TextBlock Text="Bulk Import · Excel / CSV" Classes="heading"/><TextBlock Text="Drag and drop a file containing company numbers, or browse to select one." Classes="muted"/><TextBlock Text="{Binding ImportInfo}"/><StackPanel Orientation="Horizontal"><Button Content="Browse File" Command="{Binding BrowseCommand}"/><Button Content="Add to Queue" Command="{Binding QueueImportCommand}" Classes="primary"/></StackPanel><StackPanel IsVisible="{Binding IsBulkDetails}" Spacing="10"><TextBlock Text="Company number column"/><ComboBox ItemsSource="{Binding ImportColumns}" SelectedIndex="{Binding ImportColumn}"/><TextBlock Text="{Binding ImportPreviewText}" Classes="muted" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
     <Border Classes="panel"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Start Processing" Classes="primary" Command="{Binding StartCommand}"/><Button Grid.Column="2" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/><Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}"/></Grid><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6"/><TextBlock Text="{Binding Message}" Foreground="#87C7FF" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Classes="panel" IsVisible="{Binding IsResults}"><StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Results · Latest Annual Revenue" Classes="heading"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Export" Command="{Binding ExportCommand}"/><Button Content="Clear All" Command="{Binding ClearCommand}"/></StackPanel></Grid>
      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding Search}" PlaceholderText="Filter by company name or number"/><ComboBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/></Grid>
      <StackPanel Orientation="Horizontal" Spacing="24"><TextBlock Text="{Binding Total, StringFormat='Total: {0}'}"/><TextBlock Text="{Binding Found, StringFormat='Revenue found: {0}'}" Foreground="#8AE1C4"/><TextBlock Text="{Binding NotDisclosed, StringFormat='Not disclosed: {0}'}" Foreground="#F0CA75"/><TextBlock Text="{Binding Failed, StringFormat='Failed: {0}'}" Foreground="#ED9CAE"/><TextBlock Text="{Binding ProcessingCount, StringFormat='Processing: {0}'}"/></StackPanel>
      <DataGrid ItemsSource="{Binding ResultsView}" SelectedItem="{Binding Selected}" Height="300" CanUserSortColumns="True"><DataGrid.Columns>
       <DataGridTextColumn Header="Company Registration Number" Binding="{Binding CompanyNumber}" Width="195"/><DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Latest Revenue" Binding="{Binding RevenueDisplay}" Width="160"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="85"/><DataGridTextColumn Header="Financial Year" Binding="{Binding FinancialYear}" Width="105"/><DataGridTextColumn Header="Extraction Status" Binding="{Binding PrimaryStatus}" Width="220"/><DataGridTextColumn Header="Source Document" Binding="{Binding SourceUrl}" Width="250"/>
      </DataGrid.Columns></DataGrid>
      <WrapPanel><Button Content="Company Profile" Command="{Binding ProfileCommand}"/><Button Content="Original Filing" Command="{Binding FilingCommand}"/><Button Content="Download Source" Command="{Binding DownloadCommand}"/><Button Content="Retry Extraction" Command="{Binding RetryCommand}"/></WrapPanel>
      <TextBox Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="200" MaxHeight="350"/>
      <Expander Header="Revenue evidence and manual review"><StackPanel Spacing="12">
       <ListBox ItemsSource="{Binding Selected.Candidates}" SelectedItem="{Binding SelectedCandidate}" Height="180"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
       <TextBox Text="{Binding CandidateEvidence, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" Height="200"/><Button Content="Open original PDF for review" Command="{Binding OpenReviewPdfCommand}" HorizontalAlignment="Left"/>
       <TextBlock Text="Confirm only an exact latest-period figure after inspecting the source." Classes="muted"/><Grid ColumnDefinitions="*,*,*"><TextBox Text="{Binding ReviewAmount}" PlaceholderText="Exact full amount" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding ReviewCurrency}" PlaceholderText="Currency code" Margin="0,0,12,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding ReviewEntities}" SelectedItem="{Binding ReviewEntity}"/></Grid>
       <Grid ColumnDefinitions="*,*"><TextBox Text="{Binding ReviewPeriod}" PlaceholderText="Period end yyyy-MM-dd" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding ReviewPage}" PlaceholderText="Source page"/></Grid><TextBox Text="{Binding ReviewReason}" PlaceholderText="Review reason and evidence"/><CheckBox Content="I inspected and confirmed the source, year, amount, currency, scale and entity." IsChecked="{Binding SourceInspected}"/><Button Content="Confirm manually verified revenue" Command="{Binding ConfirmRevenueCommand}" Classes="primary" HorizontalAlignment="Left"/><TextBox Text="{Binding ReviewHistory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200"/>
      </StackPanel></Expander>
     </StackPanel></Border>
     <Border Classes="panel" IsVisible="{Binding IsExport}"><StackPanel Spacing="18"><TextBlock Text="Export Results" Classes="heading"/><TextBlock Text="Export the seven primary fields, one latest annual result per company." Classes="muted"/><ComboBox ItemsSource="{Binding ExportScopes}" SelectedItem="{Binding ExportScope}" HorizontalAlignment="Left"/><Button Content="Export to Excel / CSV" Command="{Binding ExportCommand}" Classes="primary" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Classes="panel" IsVisible="{Binding IsSettings}"><StackPanel Spacing="12"><TextBlock Text="Settings and API Connection" Classes="heading"/><TextBlock Text="Companies House API key"/><TextBox x:Name="ApiKeyBox" PasswordChar="●" PlaceholderText="REST API key"/><TextBlock Text="Protected by Windows DPAPI or macOS Keychain. Credentials are never included in exports." Classes="muted"/>
      <Grid ColumnDefinitions="*,*,*"><StackPanel Margin="0,0,12,0"><TextBlock Text="Request timeout (seconds)"/><TextBox Text="{Binding Settings.TimeoutSeconds}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Concurrent companies"/><TextBox Text="{Binding Settings.Concurrency}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Requests / five minutes"/><TextBox Text="{Binding Settings.RequestsPerFiveMinutes}"/></StackPanel></Grid>
      <TextBlock Text="Download folder"/><TextBox Text="{Binding Settings.DownloadFolder}"/><TextBlock Text="Temporary OCR folder"/><TextBox Text="{Binding Settings.TemporaryFolder}"/><CheckBox Content="Save source PDFs to download folder" IsChecked="{Binding Settings.SaveSourcePdfs}"/><CheckBox Content="Enable offline Tesseract OCR" IsChecked="{Binding Settings.EnableOcr}"/><TextBlock Text="Tesseract executable"/><TextBox Text="{Binding Settings.TesseractPath}"/><CheckBox Content="Process all pages requiring OCR" IsChecked="{Binding Settings.OcrAllPages}"/><TextBlock Text="Maximum OCR pages (0 = all)"/><TextBox Text="{Binding Settings.OcrMaxPages}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme}" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal"><Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Classes="primary"/><Button Content="Test API Connection" Command="{Binding TestConnectionCommand}"/></StackPanel>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="#0A1427" BorderBrush="#29446A" BorderThickness="0,1,0,0" Padding="22,10"><Grid ColumnDefinitions="270,*"><TextBlock Text="{Binding Connection}" Foreground="#82B5EC" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Message}" Classes="muted" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>

